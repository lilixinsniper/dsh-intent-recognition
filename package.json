{
  "name": "dsh-intent-recognition",
  "version": "0.6.1",
  "description": "DeepSeek Harness plugin: five-layer intent recognition (rules / vector / Jev / fine-tuned / LLM fallback) with PostgreSQL + pgvector, scenario & service management UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docker-compose.yml"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "intent-recognition",
    "pgvector"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilixinsniper/dsh-intent-recognition.git"
  },
  "homepage": "https://github.com/lilixinsniper/dsh-intent-recognition#readme",
  "bugs": "https://github.com/lilixinsniper/dsh-intent-recognition/issues",
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "external": [
        "react",
        "react/jsx-runtime",
        "react-dom",
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-client-ui-slots",
        "zod"
      ]
    },
    "catalog": {
      "category": "integration",
      "summary": {
        "en": "Five-layer intent recognition pipeline with scenario/intent management, PostgreSQL + pgvector storage and API services.",
        "zh": "五层意图识别流水线：规则/向量/Jev/微调/LLM兜底，场景与意图管理、PostgreSQL + pgvector 存储、API 服务。"
      },
      "capabilities": [
        "http",
        "database"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.6 <0.3.0 || >=0.2.0-0 <0.3.0",
    "@deepseek-ai/schemastery": ">=0.1.0-rc.6 <0.3.0 || >=0.2.0-0 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "*",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "esbuild": "^0.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pg": "^8.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
